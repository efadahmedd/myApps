def main():
    tasks = []
    while True :
        print("=======ToDoList=======")
        print("1. Add a task")
        print("2. Remove a task")
        print("3. view list")
        print("4. Quit")
        print()

        choice = int(input("give me the option no. :"))

        if choice == 1:
            print()
            task = input("give me a task :")
            tasks.append(task)
            print()
            print(f"the task '{task}' has been added to the to-do-list")

        elif choice == 2:
            print()
            remove = int(input("give the the index of task you need to remove :"))
            tasks.pop(remove -1)

        elif choice == 3:
            print("here is your task list :")
            for index , task in enumerate(tasks , start=1):
                print(index , task)

        elif choice == 4:
            print("cya")
            break
        else:
            print("please dont act like a ****bag")


main()
